#!/usr/bin/env bash

set -euo pipefail

repo=""

# omarchy-launch-terminal starts this command in the focused terminal's current
# directory. Resolve nested folders to the repository root before launching.
if repo=$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null); then
  exec lazygit -p "$repo"
fi

# If the focused application was not a terminal (or its directory was not a
# repository), offer known repositories instead of launching lazygit in $HOME.
declare -a candidates=()
for root in "$HOME/Github" "$HOME/Projects" "$HOME/Code" "$HOME/src"; do
  [[ -d "$root" ]] || continue
  while IFS= read -r git_marker; do
    candidates+=("$(dirname -- "$git_marker")")
  done < <(find "$root" -mindepth 1 -maxdepth 6 -name .git -prune -print 2>/dev/null)
done

if command -v zoxide >/dev/null 2>&1; then
  while IFS= read -r directory; do
    [[ -d "$directory" ]] || continue
    if repo=$(git -C "$directory" rev-parse --show-toplevel 2>/dev/null); then
      candidates+=("$repo")
    fi
  done < <(zoxide query --list 2>/dev/null || true)
fi

if (( ${#candidates[@]} == 0 )); then
  echo "No Git repositories were found under ~/Github, ~/Projects, ~/Code, or ~/src."
  echo "Press Enter to close."
  read -r
  exit 1
fi

repo=$(printf '%s\n' "${candidates[@]}" | sort -u | fzf --prompt='Repository > ' --height=100%) || exit 0
exec lazygit -p "$repo"
