# Portable choices shared by bootstrap, apply, and doctor.
SYSTEM_MIRROR_THEME=masseffect
SYSTEM_MIRROR_BROWSER=chromium
SYSTEM_MIRROR_TERMINAL=foot
SYSTEM_MIRROR_EDITOR=nvim

# Firmware unit IDs for Jonathan's physical Logitech devices. These IDs remain
# stable when the same hardware moves between a Bolt receiver and Bluetooth.
SYSTEM_MIRROR_MX_MOUSE_ID=CCAF987C
SYSTEM_MIRROR_MX_KEYBOARD_ID=7D9A1846
